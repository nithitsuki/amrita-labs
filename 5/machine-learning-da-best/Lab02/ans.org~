*** Cost of Each Product Using Pseudo-Inverse

#+begin_src python :session lab02 :results value :exports both
X_pinv = np.linalg.pinv(X)
cost = X_pinv @ y

candy = cost[0,0]
mango = cost[1,0]
milk  = cost[2,0]

y_pred = X @ cost
err = np.sum((y_pred.flatten() - y.flatten())**2)

